# AI Chat — Vercel AI Gateway (sole AI channel)
# Copy this file to .env.local and fill in your values.
#
# The Chat route (app/api/chat/route.ts) uses @ai-sdk/gateway as the single
# provider. Auth is via AI_GATEWAY_API_KEY (local) or VERCEL_OIDC_TOKEN
# injected automatically on Vercel. The model identifier is the
# gateway-routed form `provider/model` (e.g. alibaba/qwen3.7-flash).
# Free Tier models are rate limited; see https://vercel.com/ai-gateway/models?freeTier=true.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL_ID=alibaba/qwen3.7-flash
